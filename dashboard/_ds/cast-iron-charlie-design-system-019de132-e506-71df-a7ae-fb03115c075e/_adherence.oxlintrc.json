{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Playfair Display|Libre Baskerville|Barlow Condensed))/i]",
        "message": "Font not provided by the design system. Available: Playfair Display, Libre Baskerville, Barlow Condensed."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchivePage'] > JSXAttribute > JSXIdentifier[name!=/^(?:onNavigate|key|ref|className|style|children)$/]",
        "message": "<ArchivePage> doesn't accept that prop. Declared props: onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:onNavigate|key|ref|className|style|children)$/]",
        "message": "<ContentSection> doesn't accept that prop. Declared props: onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:onCTAClick|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: onCTAClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Nav'] > JSXAttribute > JSXIdentifier[name!=/^(?:currentPage|onNavigate|key|ref|className|style|children)$/]",
        "message": "<Nav> doesn't accept that prop. Declared props: currentPage, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='Nav'] > JSXAttribute[name.name='currentPage'] > Literal[value!=/^(?:main|archive)$/]",
        "message": "<Nav> currentPage must be one of 'main' | 'archive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "ArchivePage": {
        "replaces": []
      },
      "ContentSection": {
        "replaces": []
      },
      "Hero": {
