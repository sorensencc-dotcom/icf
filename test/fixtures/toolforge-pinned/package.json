{
  "name": "toolforge-marketplace",
  "version": "1.0.0",
  "type": "module",
  "description": "Toolforge Marketplace: API + UI for skill discovery and installation",
  "main": "src/api/server.js",
  "scripts": {
    "docs:sync": "node scripts/doc-sync/run.mjs",
    "test:doc-sync": "node --test tests/doc-sync-registry.test.mjs tests/doc-sync-stage-mirror.test.mjs tests/doc-sync-sidebar-guard.test.mjs tests/doc-sync-publish.test.mjs tests/doc-sync-run.test.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "kb:status": "node kb-sync/scripts/check-status.mjs",
    "kb:sync:status": "node kb-sync/scripts/check-status.mjs",
    "kb:sync:consolidate": "node scripts/consolidate-pack.mjs",
    "kb:dag": "node kb-sync/scripts/build-dag.mjs",
    "kb:dag:check": "node kb-sync/scripts/build-dag.mjs --check-only",
    "kb:dag:recover": "node kb-sync/scripts/build-dag.mjs --recover",
    "trm:closed-loop": "node kb-sync/scripts/run-closed-loop-research.mjs",
    "trm:kisp:validate": "node scripts/validate-trm-semantics.mjs",
    "trm:kisp:sync": "node scripts/notebooklm/dispatch-multi-notebook.mjs",
    "trm:kisp:dry-run": "node scripts/notebooklm/dispatch-multi-notebook.mjs --dry-run",
    "migrate": "node src/db/migrate.js",
    "trending:refresh": "node src/services/trending-batch.js",
    "trending:schedule": "pwsh src/services/trending-scheduler.ps1",
    "trending:unschedule": "pwsh src/services/trending-scheduler.ps1 -Unregister",
    "e2e": "node src/e2e/harness.js",
    "load:marketplace": "node src/load-tests/marketplace-load.js",
    "migrate:reset": "psql $DATABASE_URL -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && npm run migrate",
    "api:dev": "node --watch src/api/server.js",
    "api:build": "echo 'ESM, no build needed'",
    "ui:dev": "vite src/ui",
    "ui:build": "vite build src/ui",
    "ui:preview": "vite preview src/ui",
    "ui:test": "vitest run",
    "test": "node --test src/**/*.test.js toolforge-pdf/*.test.js",
    "test:vision": "vitest run --config vitest.config.vision.js",
    "test:providers": "vitest run --config vitest.config.providers.js",
    "test:scheduler": "pwsh src/services/__tests__/trending-scheduler.test.ps1",
    "test:healing": "npx tsx --test modules/healing/*.test.ts",
    "test:trm": "npx tsx --test tests/validate-chunks.test.ts",
    "test:watchlist": "node test-watchlist-run.mjs",
    "wiki:publish": "node scripts/sync-github-wiki.mjs",
    "wiki:sync": "node scripts/sync-github-wiki.mjs",
    "wiki:qa": "node tools/wiki-browser-qa/runner.mjs",
    "wiki:qa:neo": "node tools/wiki-browser-qa/runner.mjs --backend=neo",
    "test:floor": "node tests/deterministicVerificationFloor.test.mjs",
    "docs:validate": "node scripts/validate-docs-publishing.mjs",
    "test:watch": "node --test --watch src/**/*.test.js",
    "preflight": "pwsh -NoProfile -File scripts/preflight.ps1",
    "lint": "eslint src/**/*.js",
    "pre-flight": "npm run lint && npm test && npm run test:vision && npm run test:scheduler && npm run test:healing && npm run test:trm && npm run index:validate",
    "index:validate": "pwsh -NoProfile -File scripts/validate-codebase-index.ps1",
    "stress:gate04": "node src/stress-tests/gate04-fairness.js",
    "dev": "npm run api:dev",
    "sweep:whichllm": "npm --prefix CIC-GOVERNANCE run sweep:whichllm",
    "decide:whichllm": "npm --prefix CIC-GOVERNANCE run decide:whichllm",
    "install:whichllm": "npm --prefix CIC-GOVERNANCE run install:whichllm",
    "test:whichllm": "npm --prefix CIC-GOVERNANCE run test:whichllm",
    "simulate:whichllm": "npm --prefix CIC-GOVERNANCE run simulate:whichllm",
    "plan:whichllm": "npm --prefix CIC-GOVERNANCE run plan:whichllm",
    "viking-vfs": "node modules/mcp/viking-vfs-server.mjs",
    "test:viking": "node --test modules/mcp/*.test.mjs scripts/benchmark-viking-token-savings.test.mjs && npm --prefix modules/viking-client test",
    "benchmark:viking": "node scripts/benchmark-viking-token-savings.mjs",
    "lint:script": "node scripts/lint-script-claims.mjs",
    "morning:ingest": "node scripts/morning-ingest.mjs",
    "morning:ingest:stream": "node scripts/morning-ingest.mjs --stream",
    "test:telemetry": "node --test modules/telemetry/*.test.mjs",
    "agent-memory-sync": "node sync-tools/agent-memory-sync.cjs",
    "bot:notebook:ingest": "node scripts/notebook-ingester-bot.mjs",
    "bot:kb:sentinel": "node scripts/kb-sentinel-bot.mjs",
    "bot:trm:triage": "node scripts/trm-bot-runner.mjs",
    "bot:watchlist:mine": "node scripts/watchlist-miner-bot.mjs",
    "bot:daemon:heal": "node scripts/daemon-healer-bot.mjs",
    "bot:ironledger:sentinel": "node scripts/ironledger-sentinel-bot.mjs",
    "bot:ci:watchdog": "node scripts/ci-watchdog-bot.mjs",
    "bot:reporter": "node scripts/ironbots-daily-reporter.mjs",
    "bot:all": "npm run bot:notebook:ingest && npm run bot:kb:sentinel && npm run bot:trm:triage && npm run bot:watchlist:mine && npm run bot:daemon:heal && npm run bot:ironledger:sentinel && npm run bot:ci:watchdog && npm run bot:trm:ingress && npm run bot:storage:pruner && npm run bot:report",
    "test:ironbots": "node --test tests/ironbots.test.mjs",
    "test:runtime-owner": "node --test modules/runtime-owner/runtime-owner.test.mjs",
    "test:runtime-owner-integration": "node --test integration-harness/open-notebook.integration.test.mjs",
    "retro:test-ratio": "pwsh -NoProfile -File scripts/investigate-retro-test-ratio.ps1"
  },
  "keywords": [
    "toolforge",
    "marketplace",
    "skills",
    "discovery"
  ],
  "author": "CIC Team",
  "license": "MIT",
  "bin": {
    "toolforge": "src/cli/index.js"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "headroom-ai": "^0.37.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.52.0",
    "jsdom": "^24.1.3",
    "nodemon": "^3.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.21.5": true
  }
}
